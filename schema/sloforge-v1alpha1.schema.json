{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/kyan9400/slo-forge/main/schema/sloforge-v1alpha1.schema.json",
  "title": "SLO Forge v1alpha1 ServiceLevelObjective",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "const": "sloforge.dev/v1alpha1"
    },
    "kind": {
      "const": "ServiceLevelObjective"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "labels"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "labels": {
          "type": "object",
          "required": ["team"],
          "additionalProperties": {
            "type": "string"
          },
          "properties": {
            "team": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "target", "window", "indicator", "runbookURL"],
      "properties": {
        "service": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "description": {
          "type": "string"
        },
        "target": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 100
        },
        "window": {
          "const": "30d"
        },
        "indicator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["badQuery", "totalQuery"],
          "properties": {
            "badQuery": {
              "type": "string",
              "pattern": "\\{\\{ \\.window \\}\\}"
            },
            "totalQuery": {
              "type": "string",
              "pattern": "\\{\\{ \\.window \\}\\}"
            }
          }
        },
        "runbookURL": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "dashboardURL": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      }
    }
  }
}
